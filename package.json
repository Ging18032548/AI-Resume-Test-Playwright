{
  "name": "ai-cv-playwright",
  "version": "1.0.0",
  "description": "Playwright E2E Test Automation for AI CV Analyzer",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:all-devices": "playwright test",
    "test:chrome": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:mobile-chrome": "playwright test --project=\"Mobile Chrome\"",
    "test:mobile-safari": "playwright test --project=\"Mobile Safari\"",
    "test:e2e": "playwright test tests/e2e",
    "test:api": "playwright test tests/api",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "codegen": "playwright codegen",
    "install:browsers": "playwright install",
    "test:auth": "playwright test tests/extended/authentication-edge.spec.ts",
    "test:upload": "playwright test tests/extended/resume-upload-edge.spec.ts",
    "test:analysis": "playwright test tests/extended/ai-analysis-edge.spec.ts",
    "test:profile": "playwright test tests/extended/profile-settings-edge.spec.ts",
    "test:navigation": "playwright test tests/extended/navigation-session.spec.ts",
    "test:mobile": "playwright test tests/extended/mobile-ui.spec.ts",
    "test:extended": "playwright test tests/extended"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.3"
  }
}